# ---------------------------------------------------------------------------
# Tasko configuration
# Copy this file to .env (local) or paste the values into Railway's Variables.
# ---------------------------------------------------------------------------

# Flask / hosting
# SECRET_KEY: any random string of 16+ characters. If omitted, Tasko generates
# one on first start and stores it in DATA_DIR/secret.key.
SECRET_KEY=
# Mount a persistent volume here (Railway: add a Volume mounted at /data).
# Leave commented out locally so the app uses ./tasko_data.
# DATA_DIR=/data
# Timezone used for "daily" routine resets and timestamps.
APP_TIMEZONE=Asia/Kolkata

# AI proof verification (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Comma-separated fallback list; the first working model is used.
GEMINI_MODEL=gemini-3.5-flash

# Social sign-in
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=com.tasko.workspace.app

# Email verification (Brevo transactional email - https://app.brevo.com)
# BREVO_SENDER_EMAIL must be a verified sender in Brevo. If Brevo's
# Security -> Authorised IPs restriction is enabled, the server's IP must be
# allowed; Railway's IP changes, so leave IP restriction off in production.
# With no key/address set, verification is skipped (local dev and tests).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply.tasko@gmail.com
BREVO_SENDER_NAME=Tasko

# Phone verification through Twilio Verify (all three are required to enable it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Added to numbers typed without a country code.
DEFAULT_COUNTRY_CODE=+91
# Comma-separated allowed prefixes. Empty = allow every country (costly).
ALLOWED_PHONE_PREFIXES=+91
# Safety cap on SMS sent by the whole app per 24 hours.
SMS_DAILY_LIMIT=200
